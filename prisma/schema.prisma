generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?  // null for OAuth-only accounts
  reviewEnabled Boolean @default(true) // on by default; users can opt out in Settings
  confidenceEnabled Boolean @default(true) // on by default; users can opt out in Settings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  results   QuizResult[]
  documents Document[]
  resetTokens PasswordResetToken[]
  reviewItems ReviewItem[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ReviewItem {
  id           String   @id @default(cuid())
  userId       String
  questionHash String   // sha256 of normalized question text — dedupes across quizzes
  question     String   // JSON snapshot of the Question
  topic        String
  stage        Int      @default(0) // index into the interval ladder
  reps         Int      @default(0) // total times reviewed
  lapses       Int      @default(0) // times answered wrong in review
  lastResult   String?  // 'correct' | 'wrong'
  dueAt        DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionHash])
  @@index([userId, dueAt])
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  title     String
  text      String
  wordCount Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  results   QuizResult[]

  @@index([userId])
}

model QuizResult {
  id              String   @id @default(cuid())
  userId          String
  documentId      String?
  score           Int
  totalQuestions  Int
  accuracy        Float
  timeTaken       Int
  timeLimit       Int
  config          String   // JSON string of config
  topicPerformance String  // JSON string of topic performance
  weakTopics      String   // JSON string array
  revisionSuggestions String // JSON string array
  questions       String   // JSON string array of Question
  userAnswers     String   // JSON string array of user answers
  confidences     String?  // JSON array of 'sure' | 'unsure' | null per question
  createdAt       DateTime @default(now())
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document        Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
}
