generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  results   QuizResult[]
}

model QuizResult {
  id              String   @id @default(cuid())
  userId          String
  score           Int
  totalQuestions  Int
  accuracy        Float
  timeTaken       Int
  timeLimit       Int
  config          String   // JSON string of config
  topicPerformance String  // JSON string of topic performance
  weakTopics      String   // JSON string array
  revisionSuggestions String // JSON string array
  questions       String   // JSON string array of Question
  userAnswers     String   // JSON string array of user answers
  createdAt       DateTime @default(now())
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
