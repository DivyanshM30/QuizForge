# ─── QuizForge Environment Variables ───
# Copy this file to .env and fill in your values.

# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# (Optional) Override the Gemini model — defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL connection string (e.g. Neon, Supabase)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your_super_secret_random_string_here"

# NextAuth.js — set to your deployment URL
NEXTAUTH_URL=http://localhost:3000

# ─── P0 features ───

# Google OAuth (optional — the button only appears when both are set)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password-reset emails via Resend (https://resend.com — free tier is fine).
# If unset, reset links are logged to the server console (dev fallback).
RESEND_API_KEY=
EMAIL_FROM="QuizForge <onboarding@resend.dev>"
